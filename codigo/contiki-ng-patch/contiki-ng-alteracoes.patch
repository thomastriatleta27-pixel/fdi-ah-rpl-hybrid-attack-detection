  * Copyright (c) 2001-2003, Adam Dunkels.
  * All rights reserved.
@@ -156,7 +157,84 @@ uint16_t uip_urglen, uip_surglen;
 #endif /* UIP_URGDATA > 0 */
 
 /* The uip_len is either 8 or 16 bits, depending on the maximum packet size.*/
+
 uint16_t uip_len, uip_slen;
+
+/* =========================================================
+ * FDI-AH - Selective Forwarding
+ * ========================================================= */
+#ifndef FDI_AH_SELECTIVE_FORWARDING
+#define FDI_AH_SELECTIVE_FORWARDING 0
+#endif
+
+#if FDI_AH_SELECTIVE_FORWARDING
+
+/*
+ * Contador deterministico de pacotes encaminhaveis.
+ * Politica experimental:
+ *   impar -> encaminha
+ *   par   -> descarta
+ *
+ * Resultado esperado: aproximadamente 50% de descarte.
+ */
+static uint32_t fdi_ah_sf_counter;
+
+static int
+fdi_ah_selective_forwarding_drop(void)
+{
+  typedef struct {
+    uint16_t source_id;
+    uint32_t sequence;
+  } fdi_ah_data_packet_t;
+
+  fdi_ah_data_packet_t packet;
+  uint16_t udp_len;
+
+  /*
+   * O ataque atua exclusivamente sobre trafego UDP encaminhado.
+   * Pacotes de controle RPL/ICMPv6 e demais protocolos seguem
+   * normalmente e nao entram no contador do ataque.
+   */
+  if(uip_last_proto != UIP_PROTO_UDP) {
+    return 0;
+  }
+
+  /*
+   * O comprimento UDP inclui os 8 bytes do cabecalho UDP.
+   * Somente interpreta o payload quando ele possui exatamente
+   * o tamanho do pacote de dados utilizado pelo FDI-AH.
+   */
+  udp_len = uip_ntohs(UIP_UDP_BUF->udplen);
+
+  if(udp_len != UIP_UDPH_LEN + sizeof(fdi_ah_data_packet_t)) {
+    return 0;
+  }
+
+  memcpy(&packet, UIP_UDP_PAYLOAD, sizeof(packet));
+
+  fdi_ah_sf_counter++;
+
+  if((fdi_ah_sf_counter % 2) == 0) {
+    printf("FDI_ATTACK,SELECTIVE_FORWARDING,"
+           "action=DROP,count=%lu,proto=%u,src=%u,seq=%lu\n",
+           (unsigned long)fdi_ah_sf_counter,
+           (unsigned)uip_last_proto,
+           (unsigned)packet.source_id,
+           (unsigned long)packet.sequence);
+    return 1;
+  }
+
+  printf("FDI_ATTACK,SELECTIVE_FORWARDING,"
+         "action=FORWARD,count=%lu,proto=%u,src=%u,seq=%lu\n",
+         (unsigned long)fdi_ah_sf_counter,
+         (unsigned)uip_last_proto,
+         (unsigned)packet.source_id,
+         (unsigned long)packet.sequence);
+
+  return 0;
+}
+#endif /* FDI_AH_SELECTIVE_FORWARDING */
+
 /** @} */
 
 /*---------------------------------------------------------------------------*/
@@ -1299,6 +1377,13 @@ uip_process(uint8_t flag)
       LOG_INFO("Forwarding packet to next hop, dest: ");
       LOG_INFO_6ADDR(&UIP_IP_BUF->destipaddr);
       LOG_INFO_("\n");
+      #if FDI_AH_SELECTIVE_FORWARDING
+      if(fdi_ah_selective_forwarding_drop()) {
+        UIP_STAT(++uip_stat.ip.drop);
+        goto drop;
+      }
+      #endif
+
       UIP_STAT(++uip_stat.ip.forwarded);
       goto send;
     } else {
@@ -1430,6 +1515,13 @@ uip_process(uint8_t flag)
           LOG_INFO("Forwarding packet to next hop ");
           LOG_INFO_6ADDR(&UIP_IP_BUF->destipaddr);
           LOG_INFO_("\n");
+          #if FDI_AH_SELECTIVE_FORWARDING
+          if(fdi_ah_selective_forwarding_drop()) {
+            UIP_STAT(++uip_stat.ip.drop);
+            goto drop;
+          }
+          #endif
+
           UIP_STAT(++uip_stat.ip.forwarded);
 
           goto send; /* Proceed to forwarding */
